    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vercel/analytics": "^2.0.1",
    "astro": "^6.4.3",
    "dompurify": "^3.4.11",
    "fit-file-parser": "^3.0.2",
    "jsqr": "^1.4.0",
    "marked": "^18.0.5",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.0",
