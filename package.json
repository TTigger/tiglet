{
  "name": "tiglet",
  "type": "module",
  "version": "0.0.1",
  "description": "A clean, no-login collection of small browser tools — built with Astro + React islands + Tailwind CSS v4.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
