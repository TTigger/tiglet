    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "satori": "^0.26.0",
    "tailwindcss": "^4.3.0",
    "vitest": "^4.1.8",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
