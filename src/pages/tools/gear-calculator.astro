  <a href="/" class="text-sm text-muted hover:text-accent">← 回到所有工具</a>
  <h1 class="mt-4 mb-8 font-serif text-3xl text-ink">齒比計算器</h1>
  <GearCalculator client:visible />
</BaseLayout>
