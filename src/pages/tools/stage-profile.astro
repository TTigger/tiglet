  <a href="/" class="text-sm text-muted hover:text-accent">← 回到所有工具</a>
  <h1 class="mt-4 mb-8 font-serif text-3xl text-ink">賽段剖面圖</h1>
  <StageProfile client:visible />
</BaseLayout>
